{
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=55000;Database=kiaicontrol;Username=admin;Password=admin",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "Provider": "Redis",
    "InstanceName": "kiai-control:"
  },
  "Jwt": {
    "Issuer": "KiaiControl",
    "Audience": "KiaiControl.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
