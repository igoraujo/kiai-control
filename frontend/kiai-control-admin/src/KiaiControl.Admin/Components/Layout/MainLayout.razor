@inherits LayoutComponentBase
@implements IDisposable
@inject AdminSession Session
@inject AdminApiClient Api
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="dashboard-shell area-@Session.Area">
    <MudLayout>
        <MudAppBar Elevation="0" Dense="true" Class="dashboard-appbar">
            <MudIconButton Icon="@Icons.Material.Filled.MenuOpen" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" Class="drawer-toggle" aria-label="Menu de navegação" />

            <div class="brand-lockup">
                <MudText Typo="Typo.subtitle1" Class="brand-title">Kiai Control</MudText>
                <MudText Typo="Typo.caption" Class="brand-subtitle">@(AdminNavigation.HasRole(Session.Current?.User,"platform_owner")?"Administração da plataforma":Session.OrganizationName)</MudText>
            </div>

            <MudSpacer />

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <span class="workspace-badge">@(Session.Area=="fight"?"FIGHT":Session.Area=="gym"?"GYM":"GERAL")</span>
                @if (Session.Current is not null)
                {
                    <MudText Typo="Typo.body2" Class="signed-in-email">@Session.Current.User.Email</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" aria-label="Sair" OnClick="LogoutAsync" />
                }
                <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled">KC</MudAvatar>
            </MudStack>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="0"
                   ClipMode="DrawerClipMode.Always"
                   Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Md"
                   MiniWidth="72px"
                   OpenMiniOnHover="true"
                   Class="dashboard-drawer">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="admin-content">
                @if(Session.Area!="shared"){
                    <div class="workspace-context"><strong>@(Session.Area=="fight"?"Fight · artes marciais":"Gym · treinamento")</strong><span>Alunos, professores, modalidades e aulas filtrados por área. Financeiro geral.</span><MudButton Size="Size.Small" OnClick="SelectShared">Visão geral</MudButton></div>
                }
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    protected override void OnInitialized() { Session.WorkspaceChanged += WorkspaceChanged; }
    private void WorkspaceChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Session.WorkspaceChanged -= WorkspaceChanged;


    private readonly MudTheme _theme = new()
    {
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "Montserrat", "Segoe UI", "sans-serif"]
            }
        },
        PaletteLight = new PaletteLight
        {
            Primary = "#12365A",
            Secondary = "#F08A24",
            Tertiary = "#36A3A8",
            Background = "#F2F5F9",
            Surface = "#FFFFFF",
            AppbarBackground = "rgba(10, 22, 35, 0.92)",
            DrawerBackground = "#0F172A",
            DrawerText = "rgba(255, 255, 255, 0.86)",
            DrawerIcon = "rgba(255, 255, 255, 0.7)",
            TextPrimary = "#0F172A",
            TextSecondary = "#5B6475"
        },
        LayoutProperties = new LayoutProperties
        {
            DrawerWidthLeft = "260px"
        }
    };

    private void SelectShared()
    {
        Session.SelectArea("shared");
        var path = new Uri(Navigation.Uri).AbsolutePath;
        Navigation.NavigateTo(path is "/clients" or "/teachers" or "/modalities" or "/lessons" or "/fitness" ? path : AdminNavigation.Home(Session.Current?.User));
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task LogoutAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Sair do painel",
            "Tem certeza de que deseja encerrar sua sessão?",
            yesText: "Sair",
            cancelText: "Cancelar");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.LogoutAsync();
        }
        catch (HttpRequestException)
        {
            await Session.ClearAsync();
        }

        Navigation.NavigateTo("/login");
    }
}
