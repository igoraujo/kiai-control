@inject AdminSession Session
@using KiaiControl.Contracts.Auth

<MudNavMenu Class="nav-root">
    <MudText Typo="Typo.overline" Class="menu-kicker">Navegação</MudText>

    <div class="menu-brand">
        <MudAvatar Size="Size.Medium" Color="Color.Secondary" Variant="Variant.Filled">KC</MudAvatar>
        <div>
            <MudText Typo="Typo.subtitle1" Class="menu-title">Kiai Control</MudText>
            <MudText Typo="Typo.caption" Class="menu-subtitle">Academia Central</MudText>
        </div>
    </div>

    <MudDivider Class="menu-divider" />

    @if (HasPermission(PermissionCodes.ReportsRead))
    {
        <MudText Typo="Typo.overline" Class="menu-kicker">Principal</MudText>
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Dashboard</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.BillingManage))
    {
        <MudNavLink Href="/billing" Icon="@Icons.Material.Filled.AccountBalanceWallet">Financeiro</MudNavLink>
    }

    @if (HasPermission(PermissionCodes.ClientsManage)
        || HasPermission(PermissionCodes.BranchesManage))
    {
        <MudText Typo="Typo.overline" Class="menu-kicker">Cadastros</MudText>
    }
    @if (HasPermission(PermissionCodes.ClientsManage))
    {
        <MudNavLink Href="/clients" Icon="@Icons.Material.Filled.Groups">Alunos</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.BranchesManage))
    {
        <MudNavLink Href="/branches" Icon="@Icons.Material.Filled.Business">Unidades</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.TeachersManage)
        || HasPermission(PermissionCodes.ModalitiesManage)
        || HasPermission(PermissionCodes.GraduationManage)
        || HasPermission(PermissionCodes.FitnessManage)
        || HasPermission(PermissionCodes.RankingManage)
        || CanReadAudit
        || HasPermission(PermissionCodes.NotificationsRead)
        || HasPermission(PermissionCodes.AccessPermissionsManage))
    {
        <MudText Typo="Typo.overline" Class="menu-kicker">Gestão</MudText>
    }
    @if (HasPermission(PermissionCodes.TeachersManage))
    {
        <MudNavLink Href="/teachers" Icon="@Icons.Material.Filled.School">Professores</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.ModalitiesManage))
    {
        <MudNavLink Href="/modalities" Icon="@Icons.Material.Filled.SportsMartialArts">Modalidades</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.GraduationManage))
    {
        <MudNavLink Href="/graduation" Icon="@Icons.Material.Filled.MilitaryTech">Graduações</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.FitnessManage))
    {
        <MudNavLink Href="/fitness" Icon="@Icons.Material.Filled.FitnessCenter">Metas fitness</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.RankingManage))
    {
        <MudNavLink Href="/rankings" Icon="@Icons.Material.Filled.Leaderboard">Rankings e medalhas</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.NotificationsRead))
    {
        <MudNavLink Href="/notifications" Icon="@Icons.Material.Filled.Notifications">Notificações</MudNavLink>
    }
    @if (CanReadAudit)
    {
        <MudNavLink Href="/audit" Icon="@Icons.Material.Filled.ManageSearch">Auditoria</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.AccessPermissionsManage))
    {
        <MudNavLink Href="/access" Icon="@Icons.Material.Filled.AdminPanelSettings">Acesso e permissões</MudNavLink>
    }

    @if (HasPermission(PermissionCodes.LessonsManage)
        || HasPermission(PermissionCodes.AttendanceManage))
    {
        <MudText Typo="Typo.overline" Class="menu-kicker">Operação</MudText>
    }
    @if (HasPermission(PermissionCodes.LessonsManage))
    {
        <MudNavLink Href="/lessons" Icon="@Icons.Material.Filled.CalendarMonth">Aulas</MudNavLink>
    }
    @if (HasPermission(PermissionCodes.AttendanceManage))
    {
        <MudNavLink Href="/attendance/pending" Icon="@Icons.Material.Filled.HowToReg">Check-ins pendentes</MudNavLink>
    }
</MudNavMenu>

@code {
    private bool HasPermission(string permission) =>
        Session.Current?.User.Permissions.Contains(permission, StringComparer.OrdinalIgnoreCase) == true;

    private bool CanReadAudit =>
        HasPermission(PermissionCodes.AuditRead)
        && Session.Current?.User.Roles.Any(role =>
            role.Equals("owner", StringComparison.OrdinalIgnoreCase)
            || role.Equals("admin", StringComparison.OrdinalIgnoreCase)) == true;
}
