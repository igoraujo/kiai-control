@page "/teachers"
@inherits CrudPageBase<TeacherResponse>

<PageTitle>Professores | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4">Professores</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Cadastro de professores e instrutores</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Novo professor</MudButton>
    </MudStack>

    @if (ErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ErrorMessage</MudAlert>
    }

    <MudTable Items="Items" Loading="IsLoading" Hover="true" Dense="true"
              Filter="@(new Func<TeacherResponse, bool>(MatchesSearch))">
        <ToolBarContent>
            <MudTextField @bind-Value="Search" Placeholder="Nome, email, documento ou telefone" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Margin="Margin.Dense" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Contato</MudTh>
            <MudTh>Unidade</MudTh>
            <MudTh>Situação</MudTh>
            <MudTh>Atuação</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudText Typo="Typo.body2">@context.FullName</MudText>
                @if (!string.IsNullOrWhiteSpace(context.PreferredName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PreferredName</MudText>
                }
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.body2">@context.Email</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Phone</MudText>
            </MudTd>
            <MudTd>@_branches.FirstOrDefault(b => b.Id == context.BranchId)?.Name</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="PersonStatus.Color(context.Status)">@PersonStatus.Label(context.Status)</MudChip></MudTd>
            <MudTd>@(context.ActiveFrom?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
            <MudTd Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Editar" OnClick="() => EditAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Excluir" OnClick="() => DeleteAsync(context.Id, context.FullName)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhum professor encontrado.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudStack>

@code {
    private IReadOnlyList<BranchResponse> _branches = [];

    protected override string Resource => "teachers";

    protected override async Task LoadExtrasAsync()
    {
        try
        {
            _branches = await Api.ListAsync<BranchResponse>("branches");
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add($"Não foi possível carregar as unidades: {exception.Message}", Severity.Warning);
        }
    }

    private bool MatchesSearch(TeacherResponse teacher) => string.IsNullOrWhiteSpace(Search)
        || Contains(teacher.FullName, Search)
        || Contains(teacher.PreferredName, Search)
        || Contains(teacher.Email, Search)
        || Contains(teacher.Document, Search)
        || Contains(teacher.Phone, Search)
        || Contains(_branches.FirstOrDefault(branch => branch.Id == teacher.BranchId)?.Name, Search);

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private Task EditAsync(TeacherResponse? item) =>
        OpenDialogAsync(item is null ? "Novo professor" : "Editar professor",
            new DialogParameters<TeacherDialog>
            {
                { x => x.Item, item },
                { x => x.Branches, _branches }
            }, MaxWidth.Medium);
}
