@page "/teachers"
@inherits CrudPageBase<TeacherResponse>

<PageTitle>Professores | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4">Professores</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Cadastro de professores e instrutores</MudText>
        </div>
        @if(CanManage){<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Novo professor</MudButton>}
    </MudStack>

    <WorkspaceAreaSelector Path="/teachers" Value="@SelectedArea" />

    @if (ErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ErrorMessage <MudButton OnClick="LoadAsync" Size="Size.Small">Tentar novamente</MudButton></MudAlert>
    }

    <MudTable @ref="Table" ServerData="LoadServerData" RowsPerPage="25" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <ToolBarContent>
            <MudTextField T="string" Value="Search" ValueChanged="SearchAsync" DebounceInterval="300" Placeholder="Nome, email, documento ou telefone" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Margin="Margin.Dense" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Contato</MudTh>
            <MudTh>Unidade</MudTh>
            <MudTh>Situação</MudTh>
            <MudTh>Atuação</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nome">
                <MudText Typo="Typo.body2">@context.FullName</MudText>
                @if (!string.IsNullOrWhiteSpace(context.PreferredName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PreferredName</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Contato">
                <MudText Typo="Typo.body2">@context.Email</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Phone</MudText>
            </MudTd>
            <MudTd DataLabel="Unidade">@_branches.FirstOrDefault(b => b.Id == context.BranchId)?.Name</MudTd>
            <MudTd DataLabel="Situação"><MudChip T="string" Size="Size.Small" Color="PersonStatus.Color(context.Status)">@PersonStatus.Label(context.Status)</MudChip></MudTd>
            <MudTd DataLabel="Atuação">@(context.ActiveFrom?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
            <MudTd DataLabel="Ações" Style="text-align:right">
                @if(CanManage){<MudIconButton Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small"
                               aria-label="Agenda e horários do professor" OnClick="() => OpenJourneyAsync(context)" />}
                @if(CanManage){<MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Editar" OnClick="() => EditAsync(context)" />}
                @if(CanManage){<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Excluir" OnClick="() => DeleteAsync(context.Id, context.FullName)" />}
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhum professor encontrado.</MudText>
        </NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" RowsPerPageString="Registros por página" InfoFormat="{first_item}-{last_item} de {all_items}" /></PagerContent>
    </MudTable>
</MudStack>

@code {
    private IReadOnlyList<BranchResponse> _branches = [];

    protected override string Resource => "teachers";

    protected override async Task LoadExtrasAsync()
    {
        try
        {
            _branches = await Api.BranchOptionsAsync("teachers");
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(string.Format(AdminSystemMessages.FailedToLoadBranches, exception.Message), Severity.Warning);
        }
    }

    private bool MatchesSearch(TeacherResponse teacher) => string.IsNullOrWhiteSpace(Search)
        || Contains(teacher.FullName, Search)
        || Contains(teacher.PreferredName, Search)
        || Contains(teacher.Email, Search)
        || Contains(teacher.Document, Search)
        || Contains(teacher.Phone, Search)
        || Contains(_branches.FirstOrDefault(branch => branch.Id == teacher.BranchId)?.Name, Search);

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private Task EditAsync(TeacherResponse? item) =>
        OpenDialogAsync(item is null ? "Novo professor" : "Editar professor",
            new DialogParameters<TeacherDialog>
            {
                { x => x.Item, item },
                { x => x.Branches, _branches }
            }, MaxWidth.Medium);

    private async Task OpenJourneyAsync(TeacherResponse teacher)
    {
        try
        {
            var modalities = await Api.AllAsync<ModalityResponse>("modalities");
            await DialogService.ShowAsync<TeacherJourneyDialog>(
                $"Jornada de {teacher.FullName}",
                new DialogParameters<TeacherJourneyDialog>
                {
                    { component => component.Teacher, teacher },
                    { component => component.Branches, _branches },
                    { component => component.Modalities, modalities.Where(modality => modality.IsActive).ToList() }
                },
                new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(string.Format(AdminSystemMessages.FailedToLoadTeacherJourney, exception.Message), Severity.Error);
        }
    }
}
