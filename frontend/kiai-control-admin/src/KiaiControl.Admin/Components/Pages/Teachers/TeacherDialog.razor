@inherits FormDialogBase

<MudDialog>
    <DialogContent>
        <MudForm @ref="Form">
            <MudStack Spacing="2">
                @if (ErrorMessage is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ErrorMessage</MudAlert>
                }
                @if(Item is null){
                    <MudSelect T="Guid?" @bind-Value="_existingPerson" Label="Pessoa já cadastrada (opcional)" Clearable="true" Variant="Variant.Outlined">
                        @foreach(var person in _candidates){<MudSelectItem T="Guid?" Value="@((Guid?)person.PersonId)">@person.FullName</MudSelectItem>}
                    </MudSelect>
                    @if(_candidateError is not null){<MudAlert Severity="Severity.Warning">@_candidateError</MudAlert>}
                }
                @if(_existingPerson is null){
                <PersonFormFields Model="_person" Branches="Branches" />
                <MudDivider />
                <MudText Typo="Typo.subtitle2">Dados do professor</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_hiredAt" Label="Data de contratação" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_activeFrom" Label="Início da atividade" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsSaving">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="IsSaving">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<PersonOptionResponse> _candidates=[];
    private Guid? _existingPerson;
    private string? _candidateError;
    protected override async Task OnInitializedAsync(){if(Item is null){try{_candidates=await Api.GetAsync<List<PersonOptionResponse>>("teachers/people");}catch(HttpRequestException){_candidateError="Não foi possível consultar pessoas existentes. Você pode tentar novamente ao reabrir o formulário.";}}}

    [Parameter] public TeacherResponse? Item { get; set; }
    [Parameter] public IReadOnlyList<BranchResponse> Branches { get; set; } = [];

    private readonly PersonFormModel _person = new();
    private DateTime? _hiredAt;
    private DateTime? _activeFrom;

    protected override void OnInitialized()
    {
        if (Item is not null)
        {
            _person.BranchId = Item.BranchId;
            _person.FullName = Item.FullName;
            _person.PreferredName = Item.PreferredName;
            _person.Email = Item.Email;
            _person.Phone = Item.Phone;
            _person.BirthDate = ToDateTime(Item.BirthDate);
            _person.Document = Item.Document;
            _person.MedicalNotes = Item.MedicalNotes;
            _person.EmergencyContactName = Item.EmergencyContactName;
            _person.EmergencyContactPhone = Item.EmergencyContactPhone;
            _person.HideFromRanking = Item.HideFromRanking;
            _person.Status = Item.Status;
            _hiredAt = ToDateTime(Item.HiredAt);
            _activeFrom = ToDateTime(Item.ActiveFrom);
        }
    }

    protected override async Task SaveCoreAsync()
    {
        if(Item is null && _existingPerson is Guid existing){await Api.CreateAsync<object,TeacherResponse>($"teachers/people/{existing}/profile",new {});return;}
        if (Item is null)
        {
            await Api.CreateAsync<CreateTeacherRequest, TeacherResponse>("teachers", new CreateTeacherRequest
            {
                BranchId = _person.BranchId,
                FullName = _person.FullName,
                PreferredName = _person.PreferredName,
                Email = _person.Email,
                Phone = _person.Phone,
                BirthDate = ToDateOnly(_person.BirthDate),
                Document = _person.Document,
                MedicalNotes = _person.MedicalNotes,
                EmergencyContactName = _person.EmergencyContactName,
                EmergencyContactPhone = _person.EmergencyContactPhone,
                HideFromRanking = _person.HideFromRanking,
                HiredAt = ToDateOnly(_hiredAt),
                ActiveFrom = ToDateOnly(_activeFrom),
                Status = _person.Status
            });
        }
        else
        {
            await Api.UpdateAsync<UpdateTeacherRequest, TeacherResponse>("teachers", Item.Id, new UpdateTeacherRequest
            {
                BranchId = _person.BranchId,
                FullName = _person.FullName,
                PreferredName = _person.PreferredName,
                Email = _person.Email,
                Phone = _person.Phone,
                BirthDate = ToDateOnly(_person.BirthDate),
                Document = _person.Document,
                MedicalNotes = _person.MedicalNotes,
                EmergencyContactName = _person.EmergencyContactName,
                EmergencyContactPhone = _person.EmergencyContactPhone,
                HideFromRanking = _person.HideFromRanking,
                HiredAt = ToDateOnly(_hiredAt),
                ActiveFrom = ToDateOnly(_activeFrom),
                Status = _person.Status
            });
        }
    }

    private static DateOnly? ToDateOnly(DateTime? date) => date is null ? null : DateOnly.FromDateTime(date.Value);

    private static DateTime? ToDateTime(DateOnly? date) => date?.ToDateTime(TimeOnly.MinValue);
}
