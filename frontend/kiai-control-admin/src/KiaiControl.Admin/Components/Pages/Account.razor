@page "/account"
@inject AdminSession Session
@inject AdminApiClient Api
@inject NavigationManager Navigation
<PageTitle>Minha conta | Kiai Control</PageTitle>
<MudStack Spacing="3" Style="max-width:700px">
    <div>
<span class="eyebrow">Preferências pessoais</span>
<MudText Typo="Typo.h4">Minha conta</MudText>
</div>
    <MudPaper Class="pa-5" Outlined="true">
<MudText Typo="Typo.h6">@Session.Current?.User.Email</MudText>
<MudStack Row="true" Wrap="Wrap.Wrap">@foreach(var role in Session.Current?.User.Roles??[]){<MudChip T="string" Size="Size.Small">@AdminNavigation.RoleLabel(role)</MudChip>}</MudStack>
</MudPaper>
    @if(_profile is not null){<MudPaper Class="pa-5" Outlined="true">
<MudText Typo="Typo.h6">Meu cadastro de aluno</MudText>
<MudText>@_profile.FullName</MudText>
<MudText>@_profile.Phone</MudText>
<MudText Typo="Typo.caption">Ingresso: @(_profile.JoinedAt?.ToString("dd/MM/yyyy")??"—") · @PersonStatus.Label(_profile.Status)</MudText>
</MudPaper>}
    <MudPaper Class="pa-5" Outlined="true">
<MudStack Spacing="3">
        <MudText Typo="Typo.h6">Alterar minha senha</MudText>
        @if(_error is not null){<MudAlert Severity="Severity.Error">@_error</MudAlert>}
        <MudTextField @bind-Value="_current" InputType="InputType.Password" Label="Senha atual" autocomplete="current-password" />
        <MudTextField @bind-Value="_new" InputType="InputType.Password" Label="Nova senha" HelperText="@PasswordPolicy.Requirements" autocomplete="new-password" />
        <MudTextField @bind-Value="_confirm" InputType="InputType.Password" Label="Confirme a nova senha" autocomplete="new-password" />
        <MudText Typo="Typo.caption">Após a alteração, entre novamente com a nova senha.</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">@(_busy?"Salvando...":"Salvar nova senha")</MudButton>
    </MudStack>
</MudPaper>
</MudStack>
