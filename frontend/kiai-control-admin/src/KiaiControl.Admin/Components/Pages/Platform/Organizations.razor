@page "/platform/organizations"
@inherits PlatformPageBase

<PageTitle>Academias | Plataforma Kiai Control</PageTitle>
<MudStack Spacing="3">
    <MudText Typo="Typo.overline" Color="Color.Secondary">Administração da plataforma</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">Academias</MudText>
        <MudButton OnClick="RegisterAsync" Disabled="IsBusy" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness">Nova academia</MudButton>
    </MudStack>
    <MudText>Cadastre academias e gerencie seus responsáveis e acessos.</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap">
        @foreach (var state in new[] { ("active", "Em operação"), ("archived", "Arquivadas"), ("all", "Todas") })
        {
            <MudButton Variant="@(_archive == state.Item1 ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Disabled="IsBusy" OnClick="() => ArchiveFilterAsync(state.Item1)">@state.Item2</MudButton>
        }
    </MudStack>
    @if (Error is not null) { <MudAlert Severity="Severity.Error">@Error</MudAlert> }
    <MudPaper Outlined="true" Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="7"><MudTextField @bind-Value="_search" Label="Buscar academia" Placeholder="Nome, documento ou e-mail" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_status" Label="Status" Variant="Variant.Outlined">
                    <MudSelectItem Value='@("all")'>Todos</MudSelectItem>
                    <MudSelectItem Value='@("active")'>Ativas</MudSelectItem>
                    <MudSelectItem Value='@("suspended")'>Suspensas</MudSelectItem>
                    <MudSelectItem Value='@("inactive")'>Inativas</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2"><MudButton OnClick="FilterAsync" Disabled="IsBusy" Variant="Variant.Outlined" Class="mt-3">Filtrar</MudButton></MudItem>
        </MudGrid>
    </MudPaper>
    <MudTable Items="_result.Items" Loading="IsBusy" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md">
        <HeaderContent><MudTh>Academia</MudTh><MudTh>Contato</MudTh><MudTh>Status</MudTh><MudTh>Ações</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Academia"><div class="platform-cell-content"><MudText>@context.Name</MudText><MudText Typo="Typo.caption">@context.Document</MudText></div></MudTd>
            <MudTd DataLabel="Contato"><div class="platform-cell-content">@context.Email<br />@context.Phone</div></MudTd>
            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@(context.DeletedAt is null && context.Status == "active" ? Color.Success : Color.Warning)">@(context.DeletedAt is not null ? "Arquivada" : PlatformLabels.Status(context.Status))</MudChip></MudTd>
            <MudTd DataLabel="Ações"><div class="platform-cell-content"><MudButton Href="@($"/platform/organizations/{context.Id}")" Color="Color.Primary">Gerenciar</MudButton><MudButton Href="@($"/platform/organizations/{context.Id}/audit")">Auditoria</MudButton></div></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>Nenhuma academia encontrada.</MudText></NoRecordsContent>
    </MudTable>
    <PlatformPagination Page="_page" Total="_result.Total" Busy="IsBusy" Changed="PageAsync" />
</MudStack>

@code {
    private PagedResponse<OrganizationResponse> _result = new([], 0);
    private int _page = 1;
    private string? _search;
    private string _status = "all";
    private string _archive = "active";
    protected override async Task LoadAsync() => _result = await Api.ListPlatformOrganizationsAsync(_page, 25, _search, _status == "all" ? null : _status, _archive);
    private Task ArchiveFilterAsync(string archive) { _archive = archive; _page = 1; return RunAsync(LoadAsync); }
    private Task FilterAsync() { _page = 1; return RunAsync(LoadAsync); }
    private Task PageAsync(int page) { _page = page; return RunAsync(LoadAsync); }
    private async Task RegisterAsync()
    {
        var dialog = await Dialogs.ShowAsync<OrganizationRegistrationDialog>("Nova academia", new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
        if (await dialog.Result is { Canceled: false, Data: OrganizationRegistrationResponse result })
            Navigation.NavigateTo($"/platform/organizations/{result.Organization.Id}");
    }
}
