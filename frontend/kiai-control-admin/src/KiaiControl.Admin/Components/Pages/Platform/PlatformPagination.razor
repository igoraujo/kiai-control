<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-3">
    <MudText Typo="Typo.body2">@Total registro(s) · Página @Page de @Math.Max(1, (int)Math.Ceiling(Total / 25d))</MudText>
    <MudStack Row="true">
        <MudButton Disabled="@(Busy || Page <= 1)" OnClick="() => Changed.InvokeAsync(Page - 1)">Anterior</MudButton>
        <MudButton Disabled="@(Busy || Page * 25 >= Total)" OnClick="() => Changed.InvokeAsync(Page + 1)">Próxima</MudButton>
    </MudStack>
</MudStack>
@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int Total { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<int> Changed { get; set; }
}
