@page "/branches"
@inherits CrudPageBase<BranchResponse>

<PageTitle>Unidades | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4">Unidades</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Gerencie as unidades da academia</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Nova unidade</MudButton>
    </MudStack>

    @if (ErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ErrorMessage</MudAlert>
    }

    <MudTable Items="Items" Loading="IsLoading" Hover="true" Dense="true"
              Filter="@(new Func<BranchResponse, bool>(b => string.IsNullOrWhiteSpace(Search) || b.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)))">
        <ToolBarContent>
            <MudTextField @bind-Value="Search" Placeholder="Buscar por nome" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Margin="Margin.Dense" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Endereço</MudTh>
            <MudTh>Cidade/UF</MudTh>
            <MudTh>CEP</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.AddressLine</MudTd>
            <MudTd>@(string.Join("/", new[] { context.City, context.State }.Where(v => !string.IsNullOrWhiteSpace(v))))</MudTd>
            <MudTd>@context.PostalCode</MudTd>
            <MudTd Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Editar" OnClick="() => EditAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Excluir" OnClick="() => DeleteAsync(context.Id, context.Name)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhuma unidade encontrada.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudStack>

@code {
    protected override string Resource => "branches";

    private Task EditAsync(BranchResponse? item) =>
        OpenDialogAsync(item is null ? "Nova unidade" : "Editar unidade",
            new DialogParameters<BranchDialog> { { x => x.Item, item } });
}
