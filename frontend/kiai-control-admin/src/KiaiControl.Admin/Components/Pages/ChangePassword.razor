@page "/change-password"
@layout Layout.LoginLayout
@inject AdminSession Session
@inject AdminApiClient Api
@inject NavigationManager Navigation

<PageTitle>Alterar senha | Kiai Control</PageTitle>

<main class="login-page">
    <section class="login-panel">
        <MudText Typo="Typo.h4" Class="login-title">Crie sua senha pessoal</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Para proteger sua conta, altere a senha temporária antes de continuar.
        </MudText>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_errorMessage</MudAlert>
        }

        <EditForm Model="_form" OnValidSubmit="ChangePasswordAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <MudStack Spacing="2">
                <MudTextField T="string" Label="Senha temporária atual" @bind-Value="_form.CurrentPassword"
                              InputType="InputType.Password" Variant="Variant.Outlined" Required="true"
                              Disabled="_isSubmitting" />
                <MudTextField T="string" Label="Nova senha" @bind-Value="_form.NewPassword"
                              InputType="InputType.Password" Variant="Variant.Outlined" Required="true"
                              HelperText="@PasswordPolicy.Requirements"
                              Disabled="_isSubmitting" />
                <MudTextField T="string" Label="Confirme a nova senha" @bind-Value="_form.ConfirmPassword"
                              InputType="InputType.Password" Variant="Variant.Outlined" Required="true"
                              Disabled="_isSubmitting" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Disabled="_isSubmitting">
                    @(_isSubmitting ? "Salvando..." : "Alterar senha")
                </MudButton>
            </MudStack>
        </EditForm>
    </section>
</main>

@code {
    private readonly ChangePasswordForm _form = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (Session.Current is null)
        {
            Navigation.NavigateTo("/login");
        }
        else if (!Session.Current.User.MustChangePassword && !Navigation.Uri.Contains("/account",StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (!string.Equals(_form.NewPassword, _form.ConfirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = "A confirmação da nova senha não corresponde.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            await Api.ChangePasswordAsync(_form.CurrentPassword, _form.NewPassword);
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class ChangePasswordForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string CurrentPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [ValidPassword]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
