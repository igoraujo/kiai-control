@inherits FormDialogBase

<MudDialog>
    <DialogContent>
        <MudForm @ref="Form">
            <MudStack Spacing="2">
                @if (ErrorMessage is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ErrorMessage</MudAlert>
                }
                <MudTextField @bind-Value="_model.Name" Label="Nome" Required="true" RequiredError="Informe o nome" Variant="Variant.Outlined" />
                <MudSelect T="Guid" @bind-Value="_model.ModalityId" Label="Modalidade" Required="true" RequiredError="Selecione a modalidade" Variant="Variant.Outlined">
                    @foreach (var modality in Modalities)
                    {
                        <MudSelectItem Value="@modality.Id">@modality.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" @bind-Value="_model.BranchId" Label="Unidade" Clearable="true" Variant="Variant.Outlined">
                    @foreach (var branch in Branches)
                    {
                        <MudSelectItem T="Guid?" Value="@branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="_model.Capacity" Label="Capacidade" Min="1" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Description" Label="Descrição" Lines="3" Variant="Variant.Outlined" />
                @if (Item is not null)
                {
                    <MudSelect T="string" @bind-Value="_model.Status" Label="Situação" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("active")">@PersonStatus.Label("active")</MudSelectItem>
                        <MudSelectItem Value="@("inactive")">@PersonStatus.Label("inactive")</MudSelectItem>
                        <MudSelectItem Value="@("archived")">@PersonStatus.Label("archived")</MudSelectItem>
                    </MudSelect>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsSaving">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="IsSaving">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public ClassGroupResponse? Item { get; set; }
    [Parameter] public IReadOnlyList<ModalityResponse> Modalities { get; set; } = [];
    [Parameter] public IReadOnlyList<BranchResponse> Branches { get; set; } = [];

    private readonly UpdateClassGroupRequest _model = new() { Capacity = 20 };

    protected override void OnInitialized()
    {
        if (Item is not null)
        {
            _model.Name = Item.Name;
            _model.ModalityId = Item.ModalityId;
            _model.BranchId = Item.BranchId;
            _model.Description = Item.Description;
            _model.Capacity = Item.Capacity;
            _model.Status = Item.Status;
        }
    }

    protected override async Task SaveCoreAsync()
    {
        if (Item is null)
        {
            await Api.CreateAsync<CreateClassGroupRequest, ClassGroupResponse>("class-groups", new CreateClassGroupRequest
            {
                Name = _model.Name,
                ModalityId = _model.ModalityId,
                BranchId = _model.BranchId,
                Description = _model.Description,
                Capacity = _model.Capacity
            });
        }
        else
        {
            await Api.UpdateAsync<UpdateClassGroupRequest, ClassGroupResponse>("class-groups", Item.Id, _model);
        }
    }
}
