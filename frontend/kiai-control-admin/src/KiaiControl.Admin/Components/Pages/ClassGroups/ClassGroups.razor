@page "/class-groups"
@inherits CrudPageBase<ClassGroupResponse>

<PageTitle>Turmas | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4">Turmas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Turmas, capacidade e situação</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Nova turma</MudButton>
    </MudStack>

    @if (ErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ErrorMessage</MudAlert>
    }

    <MudTable Items="Items" Loading="IsLoading" Hover="true" Dense="true"
              Filter="@(new Func<ClassGroupResponse, bool>(g => string.IsNullOrWhiteSpace(Search) || g.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)))">
        <ToolBarContent>
            <MudTextField @bind-Value="Search" Placeholder="Buscar por nome" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Margin="Margin.Dense" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Modalidade</MudTh>
            <MudTh>Unidade</MudTh>
            <MudTh>Capacidade</MudTh>
            <MudTh>Situação</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@_modalities.FirstOrDefault(m => m.Id == context.ModalityId)?.Name</MudTd>
            <MudTd>@_branches.FirstOrDefault(b => b.Id == context.BranchId)?.Name</MudTd>
            <MudTd>@context.Capacity</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="PersonStatus.Color(context.Status)">@PersonStatus.Label(context.Status)</MudChip></MudTd>
            <MudTd Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small" aria-label="Gerenciar horários, professores e matrículas" OnClick="() => ManageAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Editar" OnClick="() => EditAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Excluir" OnClick="() => DeleteAsync(context.Id, context.Name)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhuma turma encontrada.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudStack>

@code {
    private IReadOnlyList<ModalityResponse> _modalities = [];
    private IReadOnlyList<BranchResponse> _branches = [];

    protected override string Resource => "class-groups";

    protected override async Task LoadExtrasAsync()
    {
        try
        {
            _modalities = await Api.ListAsync<ModalityResponse>("modalities");
            _branches = await Api.ListAsync<BranchResponse>("branches");
        }
        catch (HttpRequestException)
        {
            // A listagem principal reporta falhas de API/permissão.
        }
        catch (UnauthorizedAccessException)
        {
            Session.Clear();
            Navigation.NavigateTo("/login");
        }
    }

    private Task EditAsync(ClassGroupResponse? item) =>
        OpenDialogAsync(item is null ? "Nova turma" : "Editar turma",
            new DialogParameters<ClassGroupDialog>
            {
                { x => x.Item, item },
                { x => x.Modalities, _modalities },
                { x => x.Branches, _branches }
            });

    private void ManageAsync(ClassGroupResponse item) => Navigation.NavigateTo($"/class-groups/{item.Id}");
}
