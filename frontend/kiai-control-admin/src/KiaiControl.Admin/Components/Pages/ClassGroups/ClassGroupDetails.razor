@page "/class-groups/{ClassGroupId:guid}"
@inject AdminApiClient Api
@inject AdminSession Session
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@(_classGroup?.Name ?? "Turma") | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" aria-label="Voltar para turmas" OnClick="BackToList" />
        <div>
            <MudText Typo="Typo.h4">@(_classGroup?.Name ?? "Turma")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Horários, professores e matrículas</MudText>
        </div>
    </MudStack>

    @if (_isLoading)
    {
        <MudSkeleton Height="280px" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @_errorMessage
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadAsync">Tentar novamente</MudButton>
        </MudAlert>
    }
    else if (_classGroup is not null)
    {
        <MudStack Row="true" Spacing="2" Class="class-group-summary">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@_modalityName</MudChip>
            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">@_activeEnrollments / @_classGroup.Capacity alunos</MudChip>
            <MudChip T="string" Color="PersonStatus.Color(_classGroup.Status)">@PersonStatus.Label(_classGroup.Status)</MudChip>
        </MudStack>

        <MudTabs Rounded="false" Elevation="0">
            <MudTabPanel Text="Horários" Icon="@Icons.Material.Filled.Schedule">
                <MudStack Spacing="3" Class="class-group-section">
                    <MudText Typo="Typo.h6">Adicionar horário semanal</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4">
                            <MudSelect T="int" @bind-Value="_dayOfWeek" Label="Dia da semana" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var weekday in Weekdays)
                                {
                                    <MudSelectItem Value="@weekday.Value">@weekday.Label</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="3"><MudTextField T="string" @bind-Value="_startsAt" Label="Início" InputType="InputType.Time" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="6" sm="3"><MudTextField T="string" @bind-Value="_endsAt" Label="Término" InputType="InputType.Time" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12" sm="2"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="_isSaving" OnClick="AddScheduleAsync">Adicionar</MudButton></MudItem>
                    </MudGrid>

                    @if (_schedules.Count == 0)
                    {
                        <MudText Color="Color.Secondary">Nenhum horário cadastrado.</MudText>
                    }
                    else
                    {
                        <MudTable Items="_schedules" Dense="true" Hover="true">
                            <HeaderContent><MudTh>Dia</MudTh><MudTh>Horário</MudTh><MudTh Style="text-align:right">Ações</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd>@DayName(context.DayOfWeek)</MudTd>
                                <MudTd>@context.StartsAt.ToString("HH:mm") - @context.EndsAt.ToString("HH:mm")</MudTd>
                                <MudTd Style="text-align:right"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Excluir horário" OnClick="() => DeleteScheduleAsync(context)" /></MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Professores" Icon="@Icons.Material.Filled.School">
                <MudStack Spacing="3" Class="class-group-section">
                    <MudText Typo="Typo.h6">Atribuir professor</MudText>
                    @if (_teachers.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Cadastre um professor ativo antes de atribuí-lo à turma.</MudAlert>
                    }
                    else
                    {
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4">
                                <MudSelect T="Guid" @bind-Value="_teacherId" Label="Professor" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var teacher in _teachers)
                                    {
                                        <MudSelectItem Value="@teacher.Id">@teacher.FullName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" sm="3"><MudDatePicker @bind-Date="_teacherStartsAt" Label="A partir de" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="6" sm="3"><MudDatePicker @bind-Date="_teacherEndsAt" Label="Até (opcional)" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="12" sm="2"><MudCheckBox T="bool" @bind-Value="_isPrimary" Label="Principal" Color="Color.Primary" /></MudItem>
                            <MudItem xs="12"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="_isSaving || _teacherId == Guid.Empty || _teacherStartsAt is null" OnClick="AssignTeacherAsync">Atribuir</MudButton></MudItem>
                        </MudGrid>
                    }

                    @if (_teacherAssignments.Count == 0)
                    {
                        <MudText Color="Color.Secondary">Nenhum professor atribuído.</MudText>
                    }
                    else
                    {
                        <MudTable Items="_teacherAssignments" Dense="true" Hover="true">
                            <HeaderContent><MudTh>Professor</MudTh><MudTh>Período</MudTh><MudTh>Função</MudTh><MudTh Style="text-align:right">Ações</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.TeacherName</MudTd>
                                <MudTd>@context.StartsAt.ToString("dd/MM/yyyy") - @(context.EndsAt?.ToString("dd/MM/yyyy") ?? "atual")</MudTd>
                                <MudTd>@(context.IsPrimary ? "Principal" : "Apoio")</MudTd>
                                <MudTd Style="text-align:right"><MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Color="Color.Error" aria-label="Remover atribuição" OnClick="() => RemoveTeacherAsync(context)" /></MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Matrículas" Icon="@Icons.Material.Filled.Groups">
                <MudStack Spacing="3" Class="class-group-section">
                    <MudText Typo="Typo.h6">Matricular aluno</MudText>
                    @if (_activeClients.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Cadastre um aluno ativo antes de matriculá-lo.</MudAlert>
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="enrollment-form">
                            <MudSelect T="Guid" @bind-Value="_clientId" Label="Aluno" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var client in _activeClients)
                                {
                                    <MudSelectItem Value="@client.Id">@client.FullName</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="_isSaving || _clientId == Guid.Empty || _activeEnrollments >= _classGroup.Capacity" OnClick="EnrollAsync">Matricular</MudButton>
                        </MudStack>
                        @if (_activeEnrollments >= _classGroup.Capacity)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">A turma atingiu a capacidade máxima.</MudAlert>
                        }
                    }

                    @if (_enrollments.Count == 0)
                    {
                        <MudText Color="Color.Secondary">Nenhuma matrícula registrada.</MudText>
                    }
                    else
                    {
                        <MudTable Items="_enrollments" Dense="true" Hover="true">
                            <HeaderContent><MudTh>Aluno</MudTh><MudTh>Matriculado em</MudTh><MudTh>Situação</MudTh><MudTh Style="text-align:right">Ações</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.ClientName</MudTd>
                                <MudTd>@context.EnrolledAt.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Status == "active" ? Color.Success : Color.Default)">@(context.Status == "active" ? "Ativa" : "Cancelada")</MudChip></MudTd>
                                <MudTd Style="text-align:right">
                                    @if (context.Status == "active")
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Color="Color.Error" aria-label="Cancelar matrícula" OnClick="() => CancelEnrollmentAsync(context)" />
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter] public Guid ClassGroupId { get; set; }

    private ClassGroupResponse? _classGroup;
    private IReadOnlyList<ClassScheduleResponse> _schedules = [];
    private IReadOnlyList<EnrollmentResponse> _enrollments = [];
    private IReadOnlyList<TeacherAssignmentResponse> _teacherAssignments = [];
    private IReadOnlyList<TeacherResponse> _teachers = [];
    private IReadOnlyList<ClientResponse> _activeClients = [];
    private Guid _teacherId;
    private Guid _clientId;
    private DateTime? _teacherStartsAt = DateTime.Today;
    private DateTime? _teacherEndsAt;
    private bool _isPrimary;
    private int _dayOfWeek = (int)DateTime.Today.DayOfWeek;
    private string _startsAt = "18:00";
    private string _endsAt = "19:00";
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private static readonly (int Value, string Label)[] Weekdays =
    [
        (0, "Domingo"),
        (1, "Segunda-feira"),
        (2, "Terça-feira"),
        (3, "Quarta-feira"),
        (4, "Quinta-feira"),
        (5, "Sexta-feira"),
        (6, "Sábado")
    ];

    private int _activeEnrollments => _enrollments.Count(item => item.Status == "active");
    private string _modalityName => _modalities.FirstOrDefault(item => item.Id == _classGroup?.ModalityId)?.Name ?? "Modalidade";
    private IReadOnlyList<ModalityResponse> _modalities = [];

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _classGroup = await Api.GetAsync<ClassGroupResponse>($"class-groups/{ClassGroupId}");
            var schedulesTask = Api.GetAsync<List<ClassScheduleResponse>>($"class-groups/{ClassGroupId}/schedules");
            var enrollmentsTask = Api.GetAsync<List<EnrollmentResponse>>($"class-groups/{ClassGroupId}/enrollments");
            var assignmentsTask = Api.GetAsync<List<TeacherAssignmentResponse>>($"class-groups/{ClassGroupId}/teachers");
            var teachersTask = Api.ListAsync<TeacherResponse>("teachers", pageSize: 200);
            var clientsTask = Api.ListAsync<ClientResponse>("clients", pageSize: 200);
            var modalitiesTask = Api.ListAsync<ModalityResponse>("modalities", pageSize: 200);

            await Task.WhenAll(schedulesTask, enrollmentsTask, assignmentsTask, teachersTask, clientsTask, modalitiesTask);
            _schedules = await schedulesTask;
            _enrollments = await enrollmentsTask;
            _teacherAssignments = await assignmentsTask;
            _teachers = (await teachersTask).Where(item => item.Status == "active").ToList();
            _activeClients = (await clientsTask).Where(item => item.Status == "active").ToList();
            _modalities = await modalitiesTask;
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AddScheduleAsync()
    {
        if (!TimeOnly.TryParse(_startsAt, out var startsAt) || !TimeOnly.TryParse(_endsAt, out var endsAt) || endsAt <= startsAt)
        {
            Snackbar.Add("Informe horários válidos; o término deve ser posterior ao início.", Severity.Warning);
            return;
        }

        await SaveAsync(async () =>
        {
            await Api.CreateAsync<CreateClassScheduleRequest, ClassScheduleResponse>(
                $"class-groups/{ClassGroupId}/schedules",
                new CreateClassScheduleRequest { DayOfWeek = _dayOfWeek, StartsAt = startsAt, EndsAt = endsAt });
            _startsAt = "18:00";
            _endsAt = "19:00";
        }, "Horário adicionado.");
    }

    private async Task DeleteScheduleAsync(ClassScheduleResponse schedule)
    {
        if (await ConfirmAsync("Remover este horário semanal?"))
        {
            await SaveAsync(() => Api.DeleteAsync($"class-groups/{ClassGroupId}/schedules", schedule.Id), "Horário removido.");
        }
    }

    private async Task AssignTeacherAsync()
    {
        if (_teacherStartsAt is null)
        {
            return;
        }

        if (_teacherEndsAt < _teacherStartsAt)
        {
            Snackbar.Add("A data final não pode ser anterior à inicial.", Severity.Warning);
            return;
        }

        var assignment = new AssignClassGroupTeacherRequest
        {
            IsPrimary = _isPrimary,
            StartsAt = DateOnly.FromDateTime(_teacherStartsAt.Value),
            EndsAt = _teacherEndsAt is null ? null : DateOnly.FromDateTime(_teacherEndsAt.Value)
        };

        await SaveAsync(async () =>
        {
            await Api.PutAsync($"class-groups/{ClassGroupId}/teachers/{_teacherId}", assignment);
            _teacherEndsAt = null;
            _isPrimary = false;
        }, "Professor atribuído à turma.");
    }

    private async Task RemoveTeacherAsync(TeacherAssignmentResponse assignment)
    {
        if (await ConfirmAsync($"Remover {assignment.TeacherName} desta turma?"))
        {
            await SaveAsync(() => Api.DeleteAsync(
                $"class-groups/{ClassGroupId}/teachers/{assignment.TeacherId}",
                $"startsAt={assignment.StartsAt:yyyy-MM-dd}"), "Atribuição removida.");
        }
    }

    private async Task EnrollAsync()
    {
        await SaveAsync(
            () => Api.CreateAsync<CreateEnrollmentRequest, EnrollmentResponse>(
                $"class-groups/{ClassGroupId}/enrollments",
                new CreateEnrollmentRequest { ClientId = _clientId }),
            "Aluno matriculado.");
    }

    private async Task CancelEnrollmentAsync(EnrollmentResponse enrollment)
    {
        if (await ConfirmAsync($"Cancelar a matrícula de {enrollment.ClientName}?"))
        {
            await SaveAsync(() => Api.DeleteAsync($"class-groups/{ClassGroupId}/enrollments", enrollment.Id), "Matrícula cancelada.");
        }
    }

    private async Task SaveAsync(Func<Task> action, string successMessage)
    {
        _isSaving = true;
        try
        {
            await action();
            Snackbar.Add(successMessage, Severity.Success);
            await LoadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task<bool> ConfirmAsync(string message) =>
        await DialogService.ShowMessageBoxAsync("Confirmar", message, yesText: "Confirmar", cancelText: "Cancelar") == true;

    private void BackToList() => Navigation.NavigateTo("/class-groups");

    private static string DayName(int day) => day switch
    {
        0 => "Domingo",
        1 => "Segunda-feira",
        2 => "Terça-feira",
        3 => "Quarta-feira",
        4 => "Quinta-feira",
        5 => "Sexta-feira",
        6 => "Sábado",
        _ => "Dia inválido"
    };
}