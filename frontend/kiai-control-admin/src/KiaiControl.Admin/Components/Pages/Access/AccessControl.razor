@page "/access"
@using KiaiControl.Contracts.Auth
@inject AdminSession Session
@inject AdminApiClient Api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Acesso e permissões | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h4">Acesso e permissões</MudText>
        <MudButton Href="/people" StartIcon="@Icons.Material.Filled.ManageAccounts">Gerenciar pessoas e contas</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_isLoading">
            Atualizar
        </MudButton>
    </MudStack>

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_errorMessage</MudAlert>
    }

    @if (!_canManageAccounts)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            Seu perfil não pode administrar contas de acesso.
        </MudAlert>
    }
    else if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Class="pa-4" Outlined="true">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Criar acesso para uma pessoa</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    A pessoa receberá uma senha temporária e deverá alterá-la no primeiro acesso.
                </MudText>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" Value="_selectedPersonId" ValueChanged="SelectPerson"
                                   Label="Pessoa" Variant="Variant.Outlined"
                                   Dense="true" Disabled="@(_peopleWithoutAccounts.Count == 0)">
                            @foreach (var person in _peopleWithoutAccounts)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)person.PersonId)">
                                    @person.FullName@(string.IsNullOrWhiteSpace(person.Email) ? "" : $" — {person.Email}")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="_accountEmail" Label="E-mail de acesso"
                                      Variant="Variant.Outlined" InputType="InputType.Email" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            O e-mail de acesso deve ser exclusivo e não pode estar vinculado a outra conta na plataforma.
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_accountRoleCode" Label="Perfil de acesso"
                                   Variant="Variant.Outlined" Dense="true">
                            @foreach (var role in AssignableRoles)
                            {
                                <MudSelectItem Value="@role.Code">@role.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="_temporaryPassword" Label="Senha temporária"
                                      Variant="Variant.Outlined" InputType="InputType.Password"
                                      HelperText="@PasswordPolicy.Requirements"
                                      autocomplete="new-password" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAccountAsync"
                               Disabled="@(_isSaving || _selectedPersonId is null || string.IsNullOrWhiteSpace(_accountEmail) || string.IsNullOrWhiteSpace(_accountRoleCode) || string.IsNullOrWhiteSpace(_temporaryPassword))">
                        Criar acesso
                    </MudButton>
                    @if (_peopleWithoutAccounts.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Todas as pessoas cadastradas já possuem acesso.</MudText>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (_canManagePermissions)
        {
            <MudDivider />
            <MudText Typo="Typo.h6">Permissões por perfil</MudText>
            <MudText Typo="Typo.body2">As opções respeitam as funções de cada perfil. Alterações passam a valer na próxima requisição, com renovação da sessão.</MudText>
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                <MudSelect T="string" Value="@_selectedRoleCode" ValueChanged="SelectRoleAsync"
                           Label="Perfil" Variant="Variant.Outlined" Dense="true" Style="max-width: 320px">
                    @foreach (var role in _roles)
                    {
                        <MudSelectItem Value="@role.Code">@role.Name (@role.Code)</MudSelectItem>
                    }
                </MudSelect>
                @if (_selectedRoleCode == "owner")
                {
                    <MudText Color="Color.Secondary">As permissões do owner são fixas.</MudText>
                }
            </MudStack>

            <MudTable Items="@FilteredPermissions" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Permissão</MudTh>
                    <MudTh>Código</MudTh>
                    <MudTh>Concedida</MudTh>
                </HeaderContent>
                <RowTemplate Context="permission">
                    <MudTd DataLabel="Permissão">@permission.Name</MudTd>
                    <MudTd DataLabel="Código">@permission.Code</MudTd>
                    <MudTd DataLabel="Concedida">
                        <MudCheckBox T="bool"
                                     Value="@IsGranted(permission.Code)"
                                     ValueChanged="@(value => SetPermissionAsync(permission.Code, value))"
                                     Disabled="@(_isSaving || _selectedRoleCode == "owner" || (!IsGranted(permission.Code) && !PermissionRoleRules.CanGrant(_selectedRoleCode??"",permission.Code)))"
                                     Color="Color.Primary" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>Nenhuma permissão cadastrada.</MudText>
                </NoRecordsContent>
            </MudTable>
        }

    }
</MudStack>

@code {
    private IReadOnlyList<RoleResponse> _roles = [];
    private IReadOnlyList<PermissionResponse> _permissions = [];
    private IReadOnlyList<UserAccountCandidateResponse> _peopleWithoutAccounts = [];
    private HashSet<string> _grantedPermissions = new(StringComparer.OrdinalIgnoreCase);
    private string? _selectedRoleCode;
    private string? _accountRoleCode;
    private Guid? _selectedPersonId;
    private string _accountEmail = string.Empty;
    private string _temporaryPassword = string.Empty;
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canManageAccounts;
    private bool _canManagePermissions;

    private IEnumerable<PermissionResponse> FilteredPermissions => _permissions;
    private IEnumerable<RoleResponse> AssignableRoles => _roles.Where(role =>
        role.Code != "platform_owner"
        && (role.Code!="client" || _peopleWithoutAccounts.FirstOrDefault(p=>p.PersonId==_selectedPersonId)?.HasClientProfile==true)
        && (role.Code!="teacher" || _peopleWithoutAccounts.FirstOrDefault(p=>p.PersonId==_selectedPersonId)?.HasTeacherProfile==true)
        && (Session.Current?.User.Roles.Contains("owner", StringComparer.OrdinalIgnoreCase) == true
            || role.Code is not ("owner" or "admin")));

    private void SelectPerson(Guid? personId)
    {
        _selectedPersonId = personId;
        var selectedPerson = _peopleWithoutAccounts.FirstOrDefault(person => person.PersonId == personId);
        _accountEmail = selectedPerson?.Email ?? string.Empty;
        if(!AssignableRoles.Any(r=>r.Code==_accountRoleCode))_accountRoleCode=AssignableRoles.FirstOrDefault()?.Code;
    }

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _canManageAccounts = Session.Current.User.Permissions.Contains(
            PermissionCodes.AccessManage,
            StringComparer.OrdinalIgnoreCase);
        _canManagePermissions = Session.Current.User.Permissions.Contains(
            PermissionCodes.AccessPermissionsManage,
            StringComparer.OrdinalIgnoreCase);
        if (_canManageAccounts)
        {
            await LoadAsync();
        }
        else
        {
            _isLoading = false;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _roles = await Api.ListAccessRolesAsync();
            _peopleWithoutAccounts = await Api.ListPeopleWithoutAccountsAsync();
            if (_selectedPersonId is null
                || _peopleWithoutAccounts.All(person => person.PersonId != _selectedPersonId))
            {
                SelectPerson(_peopleWithoutAccounts.FirstOrDefault()?.PersonId);
            }

            _accountRoleCode ??= AssignableRoles.FirstOrDefault()?.Code;
            if (_canManagePermissions)
            {
                _permissions = await Api.ListAccessPermissionsAsync();
                _selectedRoleCode ??= _roles.FirstOrDefault(role => role.Code == "admin")?.Code
                    ?? _roles.FirstOrDefault()?.Code;
                if (_selectedRoleCode is not null)
                {
                    await LoadSelectedRolePermissionsAsync();
                }
            }
        }

        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateAccountAsync()
    {
        if (_selectedPersonId is not Guid personId || _isSaving)
        {
            return;
        }

        if (!PasswordPolicy.IsValid(_temporaryPassword))
        {
            _errorMessage = PasswordPolicy.Requirements;
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            var account = await Api.CreateUserAccountAsync(personId, new CreateUserAccountRequest
            {
                Email = _accountEmail,
                TemporaryPassword = _temporaryPassword,
                RoleCode = _accountRoleCode ?? string.Empty
            });
            _peopleWithoutAccounts = _peopleWithoutAccounts
                .Where(person => person.PersonId != account.PersonId)
                .ToArray();
            _selectedPersonId = _peopleWithoutAccounts.FirstOrDefault()?.PersonId;
            _accountEmail = string.Empty;
            _temporaryPassword = string.Empty;
            Snackbar.Add($"Acesso criado para {account.Email}. A senha temporária deve ser entregue com segurança.", Severity.Success);
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SelectRoleAsync(string roleCode)
    {
        _selectedRoleCode = roleCode;
        _errorMessage = null;
        try
        {
            await LoadSelectedRolePermissionsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private async Task LoadSelectedRolePermissionsAsync()
    {
        var rolePermissions = await Api.ListRolePermissionsAsync(_selectedRoleCode!);
        _grantedPermissions = rolePermissions
            .Select(permission => permission.Code)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private bool IsGranted(string permissionCode) => _grantedPermissions.Contains(permissionCode);

    private async Task SetPermissionAsync(string permissionCode, bool isGranted)
    {
        if (_selectedRoleCode is null || _selectedRoleCode == "owner" || _isSaving)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            await Api.SetRolePermissionAsync(_selectedRoleCode, permissionCode, isGranted);
            if (isGranted)
            {
                _grantedPermissions.Add(permissionCode);
            }
            else
            {
                _grantedPermissions.Remove(permissionCode);
            }

            Snackbar.Add(AdminSystemMessages.PermissionUpdated, Severity.Success);
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
