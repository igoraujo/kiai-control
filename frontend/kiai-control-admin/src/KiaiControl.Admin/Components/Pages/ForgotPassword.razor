@page "/forgot-password"
@layout Layout.LoginLayout
@inject AdminApiClient Api
<PageTitle>Recuperar acesso | Kiai Control</PageTitle>
<main class="login-page">
<section class="login-panel">
<span class="eyebrow">Kiai Control</span>
<MudText Typo="Typo.h4">Recuperar meu acesso</MudText>
<MudText>Informe seu e-mail. A academia também pode fornecer uma nova senha temporária.</MudText>
    @if(_message is not null){<MudAlert Severity="Severity.Info">@_message</MudAlert>}
    @if(_error is not null){<MudAlert Severity="Severity.Error">@_error</MudAlert>}
    <MudTextField @bind-Value="_email" InputType="InputType.Email" Label="E-mail" />
    <MudButton OnClick="SendAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary">@(_busy?"Enviando...":"Solicitar recuperação")</MudButton>
<MudLink Href="/login">Voltar para entrar</MudLink>
</section>
</main>
