@page "/reset-password"
@layout Layout.LoginLayout
@inject AdminApiClient Api
@inject NavigationManager Navigation
<PageTitle>Nova senha | Kiai Control</PageTitle>
<main class="login-page">
<section class="login-panel">
<span class="eyebrow">Kiai Control</span>
<MudText Typo="Typo.h4">Cadastre uma nova senha</MudText>
    @if(_token.Length==0){<MudAlert Severity="Severity.Warning">Abra o link de recuperação recebido por e-mail.</MudAlert>}else{
        @if(_error is not null){<MudAlert Severity="Severity.Error">@_error</MudAlert>}
        <MudTextField @bind-Value="_password" InputType="InputType.Password" Label="Nova senha" HelperText="@PasswordPolicy.Requirements" autocomplete="new-password" />
<MudTextField @bind-Value="_confirm" InputType="InputType.Password" Label="Confirme a nova senha" autocomplete="new-password" />
        <MudButton OnClick="SaveAsync" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled">Salvar nova senha</MudButton>
    }<MudLink Href="/login">Voltar para entrar</MudLink>
</section>
</main>
