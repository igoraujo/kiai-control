@inherits FormDialogBase

<MudDialog>
    <DialogContent>
        <MudForm @ref="Form">
            <MudStack Spacing="2">
                @if (ErrorMessage is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ErrorMessage</MudAlert>
                }
                <PersonFormFields Model="_person" Branches="Branches" />
                <MudDivider />
                <MudText Typo="Typo.subtitle2">Dados do aluno</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_registrationCode" Label="Código de matrícula" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_joinedAt" Label="Data de ingresso" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.subtitle2" Class="pt-2">Modalidades</MudText>
                <MudSelect T="Guid" @bind-SelectedValues="_selectedModalityIds" MultiSelection="true"
                           Label="Modalidades do aluno" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var modality in Modalities)
                    {
                        <MudSelectItem Value="@modality.Id">@modality.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsSaving">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="IsSaving">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public ClientResponse? Item { get; set; }
    [Parameter] public IReadOnlyList<BranchResponse> Branches { get; set; } = [];
    [Parameter] public IReadOnlyList<ModalityResponse> Modalities { get; set; } = [];
    [Parameter] public IReadOnlyList<Guid> SelectedModalityIds { get; set; } = [];

    private readonly PersonFormModel _person = new();
    private IReadOnlyCollection<Guid> _selectedModalityIds = Array.Empty<Guid>();
    private Guid? _createdClientId;
    private string? _registrationCode;
    private DateTime? _joinedAt;

    protected override void OnInitialized()
    {
        _selectedModalityIds = SelectedModalityIds.ToHashSet();
        if (Item is not null)
        {
            _person.BranchId = Item.BranchId;
            _person.FullName = Item.FullName;
            _person.PreferredName = Item.PreferredName;
            _person.Email = Item.Email;
            _person.Phone = Item.Phone;
            _person.BirthDate = ToDateTime(Item.BirthDate);
            _person.Document = Item.Document;
            _person.MedicalNotes = Item.MedicalNotes;
            _person.EmergencyContactName = Item.EmergencyContactName;
            _person.EmergencyContactPhone = Item.EmergencyContactPhone;
            _person.HideFromRanking = Item.HideFromRanking;
            _person.Status = Item.Status;
            _registrationCode = Item.RegistrationCode;
            _joinedAt = ToDateTime(Item.JoinedAt);
        }
    }

    protected override async Task SaveCoreAsync()
    {
        Guid clientId;
        if (Item is null)
        {
            if (_createdClientId is null)
            {
                var created = await Api.CreateAsync<CreateClientRequest, ClientResponse>("clients", new CreateClientRequest
                {
                    BranchId = _person.BranchId,
                    FullName = _person.FullName,
                    PreferredName = _person.PreferredName,
                    Email = _person.Email,
                    Phone = _person.Phone,
                    BirthDate = ToDateOnly(_person.BirthDate),
                    Document = _person.Document,
                    MedicalNotes = _person.MedicalNotes,
                    EmergencyContactName = _person.EmergencyContactName,
                    EmergencyContactPhone = _person.EmergencyContactPhone,
                    HideFromRanking = _person.HideFromRanking,
                    RegistrationCode = _registrationCode,
                    JoinedAt = ToDateOnly(_joinedAt),
                    Status = _person.Status
                });
                _createdClientId = created.Id;
            }

            clientId = _createdClientId.Value;
        }
        else
        {
            var updated = await Api.UpdateAsync<UpdateClientRequest, ClientResponse>("clients", Item.Id, new UpdateClientRequest
            {
                BranchId = _person.BranchId,
                FullName = _person.FullName,
                PreferredName = _person.PreferredName,
                Email = _person.Email,
                Phone = _person.Phone,
                BirthDate = ToDateOnly(_person.BirthDate),
                Document = _person.Document,
                MedicalNotes = _person.MedicalNotes,
                EmergencyContactName = _person.EmergencyContactName,
                EmergencyContactPhone = _person.EmergencyContactPhone,
                HideFromRanking = _person.HideFromRanking,
                RegistrationCode = _registrationCode,
                JoinedAt = ToDateOnly(_joinedAt),
                Status = _person.Status
            });
            clientId = updated.Id;
        }

        var existingModalityIds = Item is null ? new HashSet<Guid>() : SelectedModalityIds.ToHashSet();
        var desiredModalityIds = _selectedModalityIds.ToHashSet();
        foreach (var modalityId in desiredModalityIds.Except(existingModalityIds))
        {
            await Api.LinkClientModalityAsync(clientId, modalityId);
        }

        foreach (var modalityId in existingModalityIds.Except(desiredModalityIds))
        {
            await Api.UnlinkClientModalityAsync(clientId, modalityId);
        }
    }

    private static DateOnly? ToDateOnly(DateTime? date) => date is null ? null : DateOnly.FromDateTime(date.Value);

    private static DateTime? ToDateTime(DateOnly? date) => date?.ToDateTime(TimeOnly.MinValue);
}
