@page "/clients"
@inherits CrudPageBase<ClientResponse>
@using KiaiControl.Contracts.Auth

<PageTitle>Alunos | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4">Alunos</MudText>
            <MudText Typo="Typo.body2" Class="area-description">Cadastro e situação dos alunos · @AcademyArea.Label(SelectedArea)</MudText>
        </div>
        @if(CanManage){<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Novo aluno</MudButton>}
    </MudStack>

    <WorkspaceAreaSelector Path="/clients" Value="@SelectedArea" />
    <MudText Typo="Typo.body2" Class="area-description">
        @(SelectedArea == AcademyArea.General
            ? "Todos os alunos, incluindo os que ainda não possuem modalidade."
            : $"Alunos vinculados às modalidades de {AcademyArea.Label(SelectedArea)}. Quem pratica nas duas áreas aparece em ambas.")
    </MudText>

    @if (ErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ErrorMessage <MudButton OnClick="LoadAsync" Size="Size.Small">Tentar novamente</MudButton></MudAlert>
    }

    <MudTable @ref="Table" ServerData="LoadServerData" RowsPerPage="25" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <ToolBarContent>
            <MudTextField T="string" Value="Search" ValueChanged="SearchAsync" DebounceInterval="300" Placeholder="Nome, email, documento ou telefone" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Margin="Margin.Dense" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Áreas</MudTh>
            <MudTh>Contato</MudTh>
            <MudTh>Unidade</MudTh>
            <MudTh>Situação</MudTh>
            <MudTh>Ingresso</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nome">
                <MudText Typo="Typo.body2">@context.FullName</MudText>
                @if (!string.IsNullOrWhiteSpace(context.PreferredName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PreferredName</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Áreas">
                @if (context.Areas.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="area-description">Sem modalidade</MudText>
                }
                @foreach (var area in context.Areas)
                {
                    <span class="client-area-tag @area">@AcademyArea.Label(area)</span>
                }
            </MudTd>
            <MudTd DataLabel="Contato">
                <MudText Typo="Typo.body2">@context.Email</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Phone</MudText>
            </MudTd>
            <MudTd DataLabel="Unidade">@_branches.FirstOrDefault(b => b.Id == context.BranchId)?.Name</MudTd>
            <MudTd DataLabel="Situação"><MudChip T="string" Size="Size.Small" Color="PersonStatus.Color(context.Status)">@PersonStatus.Label(context.Status)</MudChip></MudTd>
            <MudTd DataLabel="Ingresso">@(context.JoinedAt?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
            <MudTd DataLabel="Ações" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.FolderShared" Size="Size.Small" aria-label="Jornada do aluno"
                               OnClick="() => OpenJourneyAsync(context)" />
                @if(CanManage){<MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Editar" OnClick="() => EditAsync(context)" />}
                @if(CanManage){<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Excluir" OnClick="() => DeleteAsync(context.Id, context.FullName)" />}
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhum aluno encontrado nesta visão.</MudText>
        </NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" RowsPerPageString="Registros por página" InfoFormat="{first_item}-{last_item} de {all_items}" /></PagerContent>
    </MudTable>
</MudStack>

@code {
    private IReadOnlyList<BranchResponse> _branches = [];
    private IReadOnlyList<ModalityResponse> _modalities = [];

    protected override string Resource => "clients";

    protected override async Task LoadExtrasAsync()
    {
        try
        {
            var branchesTask = Api.BranchOptionsAsync("clients");
            var modalitiesTask = Api.ListAssignableClientModalitiesAsync();
            await Task.WhenAll(branchesTask, modalitiesTask);
            _branches = await branchesTask;
            _modalities = await modalitiesTask;
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(string.Format(AdminSystemMessages.FailedToLoadBranches, exception.Message), Severity.Warning);
        }
    }

    private bool MatchesSearch(ClientResponse client) => string.IsNullOrWhiteSpace(Search)
        || Contains(client.FullName, Search)
        || Contains(client.PreferredName, Search)
        || Contains(client.Email, Search)
        || Contains(client.Document, Search)
        || Contains(client.Phone, Search)
        || Contains(_branches.FirstOrDefault(branch => branch.Id == client.BranchId)?.Name, Search);

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private async Task EditAsync(ClientResponse? item)
    {
        IReadOnlyList<Guid> selectedModalityIds = [];
        if (item is not null)
        {
            try
            {
                selectedModalityIds = (await Api.ListClientModalitiesAsync(item.Id))
                    .Select(modality => modality.Id)
                    .ToList();
            }
            catch (UnauthorizedAccessException)
            {
                await Session.ClearAsync();
                Navigation.NavigateTo("/login");
                return;
            }
            catch (HttpRequestException exception)
            {
                Snackbar.Add(string.Format(AdminSystemMessages.FailedToLoadStudentModalities, exception.Message), Severity.Error);
                return;
            }
        }

        await OpenDialogAsync(item is null ? "Novo aluno" : "Editar aluno",
            new DialogParameters<ClientDialog>
            {
                { x => x.Item, item },
                { x => x.Area, SelectedArea },
                { x => x.Branches, _branches },
                { x => x.Modalities, _modalities },
                { x => x.SelectedModalityIds, selectedModalityIds }
            }, MaxWidth.Medium);
    }

    private async Task OpenJourneyAsync(ClientResponse client)
    {
        try
        {
            var modalities = await Api.ListClientModalitiesAsync(client.Id);
            var hasBillingPermission = Session.Current?.User.Permissions.Contains(
                PermissionCodes.BillingManage, StringComparer.OrdinalIgnoreCase) == true;
            var dialog = await DialogService.ShowAsync<ClientJourneyDialog>(
                $"Jornada de {client.FullName}",
                new DialogParameters<ClientJourneyDialog>
                {
                    { component => component.Client, client },
                    { component => component.Modalities, modalities },
                    { component => component.HasBillingPermission, hasBillingPermission }
                },
                new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
            if (await dialog.Result is { Canceled: false, Data: "edit" })
            {
                await EditAsync(client);
            }
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(string.Format(AdminSystemMessages.FailedToLoadStudentJourney, exception.Message), Severity.Error);
        }
    }
}
