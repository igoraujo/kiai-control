@page "/clients"
@inherits CrudPageBase<ClientResponse>

<PageTitle>Alunos | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4">Alunos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Cadastro e situação dos alunos</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Novo aluno</MudButton>
    </MudStack>

    @if (ErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ErrorMessage</MudAlert>
    }

    <MudTable Items="Items" Loading="IsLoading" Hover="true" Dense="true"
              Filter="@(new Func<ClientResponse, bool>(MatchesSearch))">
        <ToolBarContent>
            <MudTextField @bind-Value="Search" Placeholder="Nome, email, documento ou telefone" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Margin="Margin.Dense" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Contato</MudTh>
            <MudTh>Unidade</MudTh>
            <MudTh>Situação</MudTh>
            <MudTh>Ingresso</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudText Typo="Typo.body2">@context.FullName</MudText>
                @if (!string.IsNullOrWhiteSpace(context.PreferredName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PreferredName</MudText>
                }
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.body2">@context.Email</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Phone</MudText>
            </MudTd>
            <MudTd>@_branches.FirstOrDefault(b => b.Id == context.BranchId)?.Name</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="PersonStatus.Color(context.Status)">@PersonStatus.Label(context.Status)</MudChip></MudTd>
            <MudTd>@(context.JoinedAt?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
            <MudTd Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Editar" OnClick="() => EditAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Excluir" OnClick="() => DeleteAsync(context.Id, context.FullName)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhum aluno encontrado.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudStack>

@code {
    private IReadOnlyList<BranchResponse> _branches = [];
    private IReadOnlyList<ModalityResponse> _modalities = [];

    protected override string Resource => "clients";

    protected override async Task LoadExtrasAsync()
    {
        try
        {
            var branchesTask = Api.ListAsync<BranchResponse>("branches");
            var modalitiesTask = Api.ListAssignableClientModalitiesAsync();
            await Task.WhenAll(branchesTask, modalitiesTask);
            _branches = await branchesTask;
            _modalities = await modalitiesTask;
        }
        catch (UnauthorizedAccessException)
        {
            Session.Clear();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add($"Não foi possível carregar as unidades: {exception.Message}", Severity.Warning);
        }
    }

    private bool MatchesSearch(ClientResponse client) => string.IsNullOrWhiteSpace(Search)
        || Contains(client.FullName, Search)
        || Contains(client.PreferredName, Search)
        || Contains(client.Email, Search)
        || Contains(client.Document, Search)
        || Contains(client.Phone, Search)
        || Contains(_branches.FirstOrDefault(branch => branch.Id == client.BranchId)?.Name, Search);

    private static bool Contains(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private async Task EditAsync(ClientResponse? item)
    {
        IReadOnlyList<Guid> selectedModalityIds = [];
        if (item is not null)
        {
            try
            {
                selectedModalityIds = (await Api.ListClientModalitiesAsync(item.Id))
                    .Select(modality => modality.Id)
                    .ToList();
            }
            catch (UnauthorizedAccessException)
            {
                Session.Clear();
                Navigation.NavigateTo("/login");
                return;
            }
            catch (HttpRequestException exception)
            {
                Snackbar.Add($"Não foi possível carregar as modalidades do aluno: {exception.Message}", Severity.Error);
                return;
            }
        }

        await OpenDialogAsync(item is null ? "Novo aluno" : "Editar aluno",
            new DialogParameters<ClientDialog>
            {
                { x => x.Item, item },
                { x => x.Branches, _branches },
                { x => x.Modalities, _modalities },
                { x => x.SelectedModalityIds, selectedModalityIds }
            }, MaxWidth.Medium);
    }
}
