@page "/lessons"
@inherits CrudPageBase<LessonResponse>

<PageTitle>Aulas | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="dashboard-heading">
        <div>
            <MudText Typo="Typo.h4">Aulas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Sessões da modalidade, chamada e check-ins por aula</MudText>
        </div>
        @if (CanManageModalities)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Schedule" OnClick="ManageModalities">Gerenciar horários</MudButton>
        }
    </MudStack>

    <WorkspaceAreaSelector Path="/lessons" Value="@SelectedArea" />

    @if ((ErrorMessage ?? _loadError) is { } error)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@error <MudButton OnClick="LoadAsync" Size="Size.Small">Tentar novamente</MudButton></MudAlert>
    }

    <MudStack Row="true" Spacing="2" Class="lesson-filters">
        <MudDatePicker Date="_from" DateChanged="FromChangedAsync" Label="De" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudDatePicker Date="_to" DateChanged="ToChangedAsync" Label="Até" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudSelect T="string" Value="_statusFilter" ValueChanged="StatusChangedAsync" Label="Situação" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@string.Empty">Todas</MudSelectItem>
            <MudSelectItem Value="@("scheduled")">Agendada</MudSelectItem>
            <MudSelectItem Value="@("completed")">Concluída</MudSelectItem>
            <MudSelectItem Value="@("rescheduled")">Reagendada</MudSelectItem>
            <MudSelectItem Value="@("canceled")">Cancelada</MudSelectItem>
        </MudSelect>
    </MudStack>

    <MudTable @ref="Table" ServerData="LoadServerData" RowsPerPage="25" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Data</MudTh>
            <MudTh>Horário</MudTh>
            <MudTh>Modalidade</MudTh>
            <MudTh>Situação</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Data">@context.StartsAt.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Horário">@context.StartsAt.ToLocalTime().ToString("HH:mm") - @context.EndsAt.ToLocalTime().ToString("HH:mm")</MudTd>
            <MudTd DataLabel="Modalidade">@LessonName(context)</MudTd>
            <MudTd DataLabel="Situação"><MudChip T="string" Size="Size.Small" Color="LessonStatusColor(context.Status)">@LessonStatusLabel(context.Status)</MudChip></MudTd>
            <MudTd DataLabel="Ações" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" Color="Color.Primary" aria-label="Abrir chamada" OnClick="() => OpenAttendance(context)" />
                @if (CanManageLessons && context.Status is "scheduled" or "rescheduled")
                {
                    <MudIconButton Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" aria-label="Reagendar aula" OnClick="() => RescheduleAsync(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" Color="Color.Error" aria-label="Cancelar aula" OnClick="() => CancelAsync(context)" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            @if (_loadError is null)
            {
                <MudText>Nenhuma aula no período selecionado.</MudText>
            }
        </NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="new int[]{10,25,50,100}" RowsPerPageString="Aulas por página" /></PagerContent>
    </MudTable>
</MudStack>

@code {
    private DateTime? _from = DateTime.Today;
    private DateTime? _to = DateTime.Today.AddDays(13);
    private string _statusFilter = string.Empty;
    private string? _loadError;
    private bool CanManageModalities => Session.Current?.User.Permissions.Contains(
        "modalities.manage", StringComparer.OrdinalIgnoreCase) == true;
    private bool CanManageLessons => Session.Current?.User.Roles.Any(role =>
        role.Equals("owner", StringComparison.OrdinalIgnoreCase)
        || role.Equals("admin", StringComparison.OrdinalIgnoreCase)
        || role.Equals("teacher", StringComparison.OrdinalIgnoreCase)) == true;

    protected override string Resource => "lessons";
    private async Task FromChangedAsync(DateTime? d){_from=d;await LoadAsync();}
    private async Task ToChangedAsync(DateTime? d){_to=d;await LoadAsync();}
    private async Task StatusChangedAsync(string s){_statusFilter=s;await LoadAsync();}
    protected override async Task<TableData<LessonResponse>> LoadServerData(TableState state,CancellationToken ct)
    {
        _loadError = null;
        try {
            var from=_from is null?"":new DateTimeOffset(_from.Value).ToString("O");
            var to=_to is null?"":new DateTimeOffset(_to.Value.AddDays(1)).ToString("O");
            var r=await Api.GetAsync<PagedResponse<LessonResponse>>($"catalog/lessons?page={state.Page+1}&pageSize={state.PageSize}&from={Uri.EscapeDataString(from)}&to={Uri.EscapeDataString(to)}&status={Uri.EscapeDataString(_statusFilter)}&area={SelectedArea}");
            return new(){Items=r.Items,TotalItems=r.Total};
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException e)
        {
            _loadError = e.StatusCode switch
            {
                System.Net.HttpStatusCode.BadRequest => e.Message,
                System.Net.HttpStatusCode.Forbidden => AdminSystemMessages.ResourceAccessPermissionDenied,
                _ => "Não foi possível carregar as aulas. Tente novamente."
            };
            await InvokeAsync(StateHasChanged);
        }
        return new(){Items=[],TotalItems=0};
    }


    private IEnumerable<LessonResponse> FilteredLessons => Items.Where(lesson =>
    {
        var localDate = lesson.StartsAt.ToLocalTime().Date;
        return (_from is null || localDate >= _from.Value.Date)
            && (_to is null || localDate <= _to.Value.Date)
            && (string.IsNullOrEmpty(_statusFilter) || lesson.Status == _statusFilter);
    });

    private static string LessonName(LessonResponse lesson) =>
        $"{lesson.ModalityName ?? "Aula"}{(string.IsNullOrWhiteSpace(lesson.BranchName) ? string.Empty : $" · {lesson.BranchName}")}";

    private Task RescheduleAsync(LessonResponse lesson) =>
        OpenDialogAsync("Reagendar aula",
            new DialogParameters<LessonDialog>
            {
                { dialog => dialog.Item, lesson }
            }, MaxWidth.Medium);

    private async Task CancelAsync(LessonResponse lesson)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Cancelar aula", $"Cancelar a aula de {LessonName(lesson)} em {lesson.StartsAt.ToLocalTime():dd/MM HH:mm}?",
            yesText: "Cancelar aula", cancelText: "Manter aula");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.CancelLessonAsync(lesson.Id, new CancelLessonRequest());
            Snackbar.Add(AdminSystemMessages.LessonCanceled, Severity.Success);
            await LoadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private void ManageModalities() => Navigation.NavigateTo("/modalities");

    private void OpenAttendance(LessonResponse lesson) => Navigation.NavigateTo($"/lessons/{lesson.Id}/attendance");

    private static Color LessonStatusColor(string status) => status switch
    {
        "completed" => Color.Success,
        "canceled" => Color.Error,
        "rescheduled" => Color.Warning,
        _ => Color.Primary
    };

    private static string LessonStatusLabel(string status) => status switch
    {
        "completed" => "Concluída",
        "canceled" => "Cancelada",
        "rescheduled" => "Reagendada",
        _ => "Agendada"
    };
}
