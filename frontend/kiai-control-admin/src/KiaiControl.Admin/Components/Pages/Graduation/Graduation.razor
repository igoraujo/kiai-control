@page "/graduation"
@using KiaiControl.Contracts.Auth
@inject AdminSession Session
@inject AdminApiClient Api
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Graduação | Kiai Control</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4">Graduações</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Organize faixas, graus e critérios por modalidade de arte marcial</MudText>
    </div>

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_errorMessage</MudAlert>
    }

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        @if (_modalities.Count == 0)
        {
            <MudPaper Class="pa-4" Elevation="0">
                <MudText Typo="Typo.h6">Graduação disponível para artes marciais</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-2">
                    Musculação, CrossFit e atividades funcionais não precisam configurar faixas e graus.
                    Para usar esta jornada, cadastre uma modalidade do tipo arte marcial.
                </MudText>
                <MudButton Href="/modalities" Variant="Variant.Filled" Color="Color.Primary">
                    Ir para modalidades
                </MudButton>
            </MudPaper>
        }
        else
        {
        <MudPaper Class="pa-4" Elevation="0">
            <MudText Typo="Typo.h6" GutterBottom="true">Sistema de graduação</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudSelect T="Guid?" Value="_selectedSystemId" ValueChanged="SelectSystemAsync"
                               Label="Sistema" Placeholder="Selecione um sistema" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var system in _systems)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)system.Id)">@SystemLabel(system)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudSelect T="Guid?" @bind-Value="_newSystemModalityId" Label="Modalidade" Variant="Variant.Outlined">
                            @foreach (var modality in _modalities)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)modality.Id)">@modality.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="_newSystemName" Label="Nome do sistema" Variant="Variant.Outlined" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSystemAsync"
                                   Disabled="_isSaving || _newSystemModalityId is null || string.IsNullOrWhiteSpace(_newSystemName)">
                            Criar sistema
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (SelectedSystem is not null)
        {
            <MudPaper Class="pa-4" Elevation="0">
                <MudText Typo="Typo.h6">Faixas e graus — @SelectedSystem.Name</MudText>
                @if (string.IsNullOrWhiteSpace(SelectedSystem.Description) is false)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@SelectedSystem.Description</MudText>
                }

                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    Cadastre as faixas na sequência desejada e configure quantos graus cada uma possui.
                    Exemplo adulto de Jiu-Jitsu: Branca, Azul, Roxa, Marrom e Preta. Para turmas infantis, use a sequência adequada.
                    Defina as aulas necessárias para cada avanço; a contagem começa após a última graduação confirmada.
                </MudText>

                <MudGrid Spacing="2" Class="mt-3">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1">Cadastrar faixa</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField @bind-Value="_newBeltName" Label="Nome da faixa" Placeholder="Ex.: Branca" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" sm="3" md="2">
                        <MudNumericField T="int" @bind-Value="_newBeltDegreeCount" Label="Quantidade de graus" Min="0" Max="99" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" sm="3" md="3">
                        <MudNumericField T="int" @bind-Value="_newBeltMinLessons" Label="Aulas para alcançar a faixa" Min="0" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="2" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateBeltAsync"
                                   Disabled="_isSaving || string.IsNullOrWhiteSpace(_newBeltName)">
                            Cadastrar faixa
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12">
                        <details>
                            <summary>Critérios adicionais (opcional)</summary>
                            <MudGrid Spacing="2" Class="mt-2">
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_newBeltMinTrainingDays" Label="Dias mínimos de treino" Min="0" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="decimal?" @bind-Value="_newBeltAttendance" Label="Frequência mínima (%)" Min="0" Max="100" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudCheckBox T="bool" @bind-Value="_newBeltRequiresEvaluation" Label="Exigir avaliação manual" Color="Color.Primary" />
                                </MudItem>
                            </MudGrid>
                        </details>
                    </MudItem>
                </MudGrid>

                <MudTable Items="_belts" Dense="true" Hover="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>Ordem</MudTh>
                        <MudTh>Faixa</MudTh>
                        <MudTh>Graus configurados</MudTh>
                        <MudTh>Aulas para alcançar faixa</MudTh>
                        <MudTh Style="text-align:right">Ações</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.HierarchyOrder</MudTd>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@ConfiguredDegrees(context.Id) / @context.DegreeCount</MudTd>
                        <MudTd>@context.MinLessons</MudTd>
                        <MudTd Style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@($"Editar faixa {context.Name}")"
                                           OnClick="() => EditBeltAsync(context)" Disabled="_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           aria-label="@($"Excluir faixa {context.Name}")"
                                           OnClick="() => DeleteBeltAsync(context)" Disabled="_isSaving" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText>Nenhuma faixa cadastrada neste sistema.</MudText></NoRecordsContent>
                </MudTable>

                <MudDivider Class="my-4" />
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1">Cadastrar grau</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="Guid?" @bind-Value="_selectedBeltId" Label="Faixa" Variant="Variant.Outlined">
                            @foreach (var belt in _belts)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)belt.Id)">
                                    @belt.Name · @ConfiguredDegrees(belt.Id)/@belt.DegreeCount graus
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="3" md="2">
                        <MudNumericField T="int" @bind-Value="_newDegreeMinLessons" Label="Aulas para o próximo grau" Min="0" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateDegreeAsync"
                                   Disabled="@(_isSaving || SelectedBelt is null || ConfiguredDegrees(SelectedBelt.Id) >= SelectedBelt.DegreeCount)">
                            Adicionar grau
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12">
                        <details>
                            <summary>Critérios adicionais (opcional)</summary>
                            <MudGrid Spacing="2" Class="mt-2">
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_newDegreeMinTrainingDays" Label="Dias mínimos de treino" Min="0" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="decimal?" @bind-Value="_newDegreeAttendance" Label="Frequência mínima (%)" Min="0" Max="100" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int?" @bind-Value="_newDegreeMinAge" Label="Idade mínima" Min="0" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudCheckBox T="bool" @bind-Value="_newDegreeRequiresEvaluation" Label="Exigir avaliação manual" Color="Color.Primary" />
                                </MudItem>
                            </MudGrid>
                        </details>
                    </MudItem>
                </MudGrid>

                <MudTable Items="_levels" Dense="true" Hover="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>Faixa</MudTh>
                        <MudTh>Grau</MudTh>
                        <MudTh>Aulas para avançar</MudTh>
                        <MudTh>Dias de treino</MudTh>
                        <MudTh>Frequência</MudTh>
                        <MudTh>Avaliação manual</MudTh>
                        <MudTh Style="text-align:right">Ações</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.BeltName</MudTd>
                        <MudTd>@(context.DegreeNumber == 0 ? "Faixa" : $"{context.DegreeNumber}º grau")</MudTd>
                        <MudTd>@context.MinLessons</MudTd>
                        <MudTd>@context.MinTrainingDays</MudTd>
                        <MudTd>@(context.MinAttendancePercentage is null ? "—" : $"{context.MinAttendancePercentage:N1}%")</MudTd>
                        <MudTd>@(context.RequiresManualEvaluation ? "Sim" : "Não")</MudTd>
                        <MudTd Style="text-align:right">
                            @if (context.DegreeNumber > 0)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               aria-label="@($"Editar {context.Name}")"
                                               OnClick="() => EditDegreeAsync(context)" Disabled="_isSaving" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               aria-label="@($"Excluir {context.Name}")"
                                               OnClick="() => DeleteDegreeAsync(context)" Disabled="_isSaving" />
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText>Cadastre faixas e graus para configurar a sequência.</MudText></NoRecordsContent>
                </MudTable>
            </MudPaper>

            <MudPaper Class="pa-4" Elevation="0">
                <MudText Typo="Typo.h6">Alunos elegíveis para promoção</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    A elegibilidade é calculada com base nos critérios do próximo nível do sistema selecionado.
                </MudText>

                <MudTable Items="_eligibleClients" Dense="true" Hover="true" Loading="_isRefreshing">
                    <HeaderContent>
                        <MudTh>Aluno</MudTh>
                        <MudTh>Nível atual</MudTh>
                        <MudTh>Próximo nível</MudTh>
                        <MudTh>Presenças</MudTh>
                        <MudTh>Frequência</MudTh>
                        <MudTh>Dias de treino</MudTh>
                        <MudTh>Ação</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.FullName</MudTd>
                        <MudTd>@LevelName(context.CurrentLevelId)</MudTd>
                        <MudTd>@LevelName(context.NextLevelId)</MudTd>
                        <MudTd>@context.AttendanceCount</MudTd>
                        <MudTd>@context.AttendancePercentage.ToString("N1")%</MudTd>
                        <MudTd>@context.TrainingDays</MudTd>
                        <MudTd>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                       OnClick="() => PromoteAsync(context)" Disabled="_isSaving">
                                Registrar graduação
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText>Nenhum aluno elegível para promoção neste sistema.</MudText></NoRecordsContent>
                </MudTable>

                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle1">Cadastrar graduação inicial</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Use para registrar o nível atual de alunos já graduados antes de usar as promoções automáticas.
                </MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudSelect T="Guid?" @bind-Value="_initialClientId" Label="Aluno" Variant="Variant.Outlined">
                            @foreach (var client in _clients)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)client.Id)">@client.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="Guid?" @bind-Value="_initialLevelId" Label="Nível inicial" Variant="Variant.Outlined">
                            @foreach (var level in _levels)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)level.Id)">@level.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker @bind-Date="_initialGrantedAt" Label="Data da graduação" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SetInitialGraduationAsync"
                                   Disabled="_isSaving || _initialClientId is null || _initialLevelId is null">
                            Registrar nível
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Selecione um sistema ou crie um sistema para começar a configurar níveis e acompanhar promoções.
            </MudAlert>
        }
        }
    }
</MudStack>

@code {
    private IReadOnlyList<GraduationSystemResponse> _systems = [];
    private IReadOnlyList<ModalityResponse> _modalities = [];
    private IReadOnlyList<ClientResponse> _clients = [];
    private IReadOnlyList<GraduationBeltResponse> _belts = [];
    private IReadOnlyList<GraduationLevelResponse> _levels = [];
    private IReadOnlyList<EligibleClientResponse> _eligibleClients = [];
    private Guid? _selectedSystemId;
    private Guid? _selectedBeltId;
    private Guid? _newSystemModalityId;
    private Guid? _initialClientId;
    private Guid? _initialLevelId;
    private string _newSystemName = string.Empty;
    private string _newBeltName = string.Empty;
    private int _newBeltDegreeCount = 4;
    private int _newBeltMinLessons;
    private int _newBeltMinTrainingDays;
    private decimal? _newBeltAttendance;
    private bool _newBeltRequiresEvaluation;
    private int _newDegreeMinLessons;
    private int _newDegreeMinTrainingDays;
    private int? _newDegreeMinAge;
    private decimal? _newDegreeAttendance;
    private bool _newDegreeRequiresEvaluation;
    private DateTime? _initialGrantedAt = DateTime.Today;
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _isSaving;
    private string? _errorMessage;

    private GraduationSystemResponse? SelectedSystem =>
        _systems.FirstOrDefault(system => system.Id == _selectedSystemId);

    private GraduationBeltResponse? SelectedBelt =>
        _belts.FirstOrDefault(belt => belt.Id == _selectedBeltId);

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!Session.Current.User.Permissions.Contains(PermissionCodes.GraduationManage, StringComparer.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            var systemsTask = Api.ListGraduationSystemsAsync();
            var optionsTask = Api.GetGraduationOptionsAsync();
            await Task.WhenAll(systemsTask, optionsTask);
            _systems = await systemsTask;
            var options = await optionsTask;
            _modalities = options.Modalities;
            _clients = options.Clients;
            if (_modalities.Count == 1)
            {
                _newSystemModalityId = _modalities[0].Id;
            }

            if (_systems.Count > 0)
            {
                await SelectSystemAsync(_systems[0].Id);
            }
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = string.Format(AdminSystemMessages.FailedToLoadGraduationData, exception.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectSystemAsync(Guid? systemId)
    {
        _selectedSystemId = systemId;
        _selectedBeltId = null;
        _belts = [];
        _levels = [];
        _eligibleClients = [];
        _initialLevelId = null;
        if (systemId is null)
        {
            return;
        }

        _isRefreshing = true;
        _errorMessage = null;
        try
        {
            var beltsTask = Api.ListGraduationBeltsAsync(systemId.Value);
            var levelsTask = Api.ListGraduationLevelsAsync(systemId.Value);
            var eligibleTask = Api.ListEligibleGraduationClientsAsync(systemId.Value);
            await Task.WhenAll(beltsTask, levelsTask, eligibleTask);
            _belts = await beltsTask;
            _levels = await levelsTask;
            _eligibleClients = await eligibleTask;
            _selectedBeltId = _belts.FirstOrDefault()?.Id;
            _initialLevelId = _levels.OrderBy(level => level.HierarchyOrder).FirstOrDefault()?.Id;
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = string.Format(AdminSystemMessages.FailedToLoadLevelsAndEligibility, exception.Message);
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task CreateSystemAsync()
    {
        if (_newSystemModalityId is null || string.IsNullOrWhiteSpace(_newSystemName))
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            var created = await Api.CreateGraduationSystemAsync(new CreateGraduationSystemRequest
            {
                ModalityId = _newSystemModalityId.Value,
                Name = _newSystemName.Trim()
            });
            _systems = await Api.ListGraduationSystemsAsync();
            _newSystemName = string.Empty;
            await SelectSystemAsync(created.Id);
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = string.Format(AdminSystemMessages.FailedToCreateGraduationSystem, exception.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CreateBeltAsync()
    {
        if (_selectedSystemId is null || string.IsNullOrWhiteSpace(_newBeltName))
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            var created = await Api.CreateGraduationBeltAsync(_selectedSystemId.Value, new CreateGraduationBeltRequest
            {
                Name = _newBeltName.Trim(),
                DegreeCount = _newBeltDegreeCount,
                MinLessons = _newBeltMinLessons,
                MinTrainingDays = _newBeltMinTrainingDays,
                MinAttendancePercentage = _newBeltAttendance,
                RequiresManualEvaluation = _newBeltRequiresEvaluation
            });
            _newBeltName = string.Empty;
            _newBeltDegreeCount = 4;
            _newBeltMinLessons = 0;
            _newBeltMinTrainingDays = 0;
            _newBeltAttendance = null;
            _newBeltRequiresEvaluation = false;
            await SelectSystemAsync(_selectedSystemId);
            _selectedBeltId = created.Id;
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = string.Format(AdminSystemMessages.FailedToCreateBelt, exception.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CreateDegreeAsync()
    {
        if (_selectedSystemId is null || _selectedBeltId is null || SelectedBelt is null
            || ConfiguredDegrees(_selectedBeltId.Value) >= SelectedBelt.DegreeCount)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            await Api.CreateGraduationDegreeAsync(_selectedSystemId.Value, _selectedBeltId.Value, new CreateGraduationDegreeRequest
            {
                MinLessons = _newDegreeMinLessons,
                MinTrainingDays = _newDegreeMinTrainingDays,
                MinAttendancePercentage = _newDegreeAttendance,
                MinAge = _newDegreeMinAge,
                RequiresManualEvaluation = _newDegreeRequiresEvaluation
            });
            _newDegreeMinLessons = 0;
            _newDegreeMinTrainingDays = 0;
            _newDegreeMinAge = null;
            _newDegreeAttendance = null;
            _newDegreeRequiresEvaluation = false;
            await SelectSystemAsync(_selectedSystemId);
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = string.Format(AdminSystemMessages.FailedToAddDegree, exception.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task EditBeltAsync(GraduationBeltResponse belt)
    {
        var dialog = await DialogService.ShowAsync<EditGraduationBeltDialog>(
            $"Editar faixa {belt.Name}",
            new DialogParameters<EditGraduationBeltDialog>
            {
                { component => component.Item, belt },
                { component => component.SystemId, belt.GraduationSystemId }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await SelectSystemAsync(_selectedSystemId);
            Snackbar.Add(AdminSystemMessages.BeltUpdated, Severity.Success);
        }
    }

    private async Task DeleteBeltAsync(GraduationBeltResponse belt)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir faixa",
            $"Excluir a faixa {belt.Name} e seus graus? Faixas com graduações registradas não podem ser excluídas.",
            yesText: "Excluir",
            cancelText: "Cancelar");
        if (confirmed != true || _selectedSystemId is null)
        {
            return;
        }

        await RunGraduationOperationAsync(async () =>
        {
            await Api.DeleteGraduationBeltAsync(_selectedSystemId.Value, belt.Id);
            await SelectSystemAsync(_selectedSystemId);
            Snackbar.Add(AdminSystemMessages.BeltDeleted, Severity.Success);
        });
    }

    private async Task EditDegreeAsync(GraduationLevelResponse degree)
    {
        var dialog = await DialogService.ShowAsync<EditGraduationDegreeDialog>(
            $"Editar {degree.Name}",
            new DialogParameters<EditGraduationDegreeDialog>
            {
                { component => component.Item, degree },
                { component => component.SystemId, degree.GraduationSystemId }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await SelectSystemAsync(_selectedSystemId);
            Snackbar.Add(AdminSystemMessages.DegreeCriteriaUpdated, Severity.Success);
        }
    }

    private async Task DeleteDegreeAsync(GraduationLevelResponse degree)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir grau",
            $"Excluir {degree.Name}? Só é possível excluir o último grau da sequência e ele não pode ter sido usado em graduações.",
            yesText: "Excluir",
            cancelText: "Cancelar");
        if (confirmed != true || _selectedSystemId is null)
        {
            return;
        }

        await RunGraduationOperationAsync(async () =>
        {
            await Api.DeleteGraduationDegreeAsync(_selectedSystemId.Value, degree.BeltId, degree.Id);
            await SelectSystemAsync(_selectedSystemId);
            Snackbar.Add(AdminSystemMessages.DegreeDeleted, Severity.Success);
        });
    }

    private async Task RunGraduationOperationAsync(Func<Task> operation)
    {
        _isSaving = true;
        _errorMessage = null;
        try
        {
            await operation();
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SetInitialGraduationAsync()
    {
        if (SelectedSystem is null || _initialClientId is null || _initialLevelId is null || _initialGrantedAt is null)
        {
            _errorMessage = AdminSystemMessages.StudentLevelAndGraduationDateRequired;
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            await Api.SetInitialGraduationAsync(_initialClientId.Value, new SetClientGraduationRequest
            {
                ModalityId = SelectedSystem.ModalityId,
                LevelId = _initialLevelId.Value,
                GrantedAt = DateOnly.FromDateTime(_initialGrantedAt.Value)
            });
            _initialClientId = null;
            await SelectSystemAsync(_selectedSystemId);
        }
        catch (UnauthorizedAccessException)
        {
            await Session.ClearAsync();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = string.Format(AdminSystemMessages.FailedToRecordInitialGraduation, exception.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task PromoteAsync(EligibleClientResponse client)
    {
        if (SelectedSystem is null)
        {
            return;
        }

        var nextLevel = _levels.FirstOrDefault(level => level.Id == client.NextLevelId);
        if (nextLevel is null)
        {
            _errorMessage = AdminSystemMessages.NextLevelNotFoundRefreshSystemLevels;
            return;
        }

        var result = await DialogService.ShowAsync<PromoteClientDialog>(
            "Registrar graduação",
            new DialogParameters<PromoteClientDialog>
            {
                { dialog => dialog.Client, client },
                { dialog => dialog.ModalityId, SelectedSystem.ModalityId },
                { dialog => dialog.NextLevelName, nextLevel.Name },
                { dialog => dialog.RequiresManualEvaluation, nextLevel.RequiresManualEvaluation }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var dialogResult = await result.Result;
        if (dialogResult is { Canceled: false })
        {
            await SelectSystemAsync(_selectedSystemId);
        }
    }

    private string LevelName(Guid levelId) =>
        _levels.FirstOrDefault(level => level.Id == levelId)?.Name ?? "Nível não encontrado";

    private int ConfiguredDegrees(Guid beltId) =>
        _levels.Count(level => level.BeltId == beltId && level.DegreeNumber > 0);

    private string SystemLabel(GraduationSystemResponse system)
    {
        var modality = _modalities.FirstOrDefault(item => item.Id == system.ModalityId)?.Name ?? "Modalidade";
        return $"{system.Name} · {modality}";
    }
}
